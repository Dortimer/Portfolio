@rendermode InteractiveServer

@* <img src="./images/catsfighting.jpg"/> *@

<div class="menu">
    <div class="mobile">
        <button @onclick="ToggleMenu" class="nav-menu-toggle">
            <img src="/images/ff-hamburger.svg" />
        </button>
    </div>

    <div id="nav" class="nav @(menuOpen ? "mobile-nav-open" : "")" tab-index="0">

        <NavLink href="/" @onclick="ToggleMenu">
            Home
        </NavLink>

        <NavLink href="resume" @onclick="ToggleMenu">
            Resume
        </NavLink>

        <NavLink href="source" @onclick="ToggleMenu">
            Source Code
        </NavLink>

        <NavLink href="schema" @onclick="ToggleMenu">
            Schema & Database Design
        </NavLink>
    </div>

    <div class="backdrop mobile @(menuOpen ? "visible" : "")" @onclick="ToggleMenu"></div>
</div>


@code{

    private bool menuOpen = false;

    [JSInvokable]
    private async Task ToggleMenu()
    {
        menuOpen = !menuOpen;
        StateHasChanged();
